# Скопируйте в .env и заполните. Сам .env в git не попадает (.gitignore).

# true — testnet, false — боевая торговля реальными деньгами.
BINANCE_TESTNET=true

# Ключи testnet (https://testnet.binancefuture.com)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Боевые ключи. Читаются только при BINANCE_TESTNET=false —
# отдельные переменные не дают случайно торговать вживую.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Инструменты ---
# Список торгуемых символов через запятую. Каждый анализируется и торгуется
# независимо, но по одинаковой стратегии и параметрам риска ниже.
# Стратегия торгует в обе стороны (лонг на пробое вверх с растущим трендом,
# шорт на пробое вниз с падающим — см. internal/strategy).
#
# ⚠️ ВАЖНО (24.08.2026): более ранний 90-дневный бэктест показывал плюс по
# всем 7 монетам ниже. Честная walk-forward проверка на 3 годах истории
# (holdout — последние 6 месяцев, разбитые на 3 независимых периода) этого
# НЕ подтвердила — каждая проверенная комбинация параметров, включая новые
# ADX-фильтр и перенос в безубыток ниже, даёт отрицательный результат на
# каждом из 3 периодов почти по всем монетам одновременно. Похоже на смену
# рыночного режима (боковик), а не на проблему конкретной монеты — сужать
# список не стали, это бы не помогло. НА РЕАЛЬНЫЕ ДЕНЬГИ ПЕРЕВОДИТЬ РАНО.
# Бот продолжает работать на testnet для сбора дальнейших данных.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,LINKUSDT
# 1h, не 5m: на 5m ATR-стоп физически слишком узкий относительно цены, и
# реальная комиссия (0.05%/сторону) съедает несоразмерно большую долю
# риска на сделку — "прибыльный" без комиссий результат на 5m оборачивался
# устойчивым минусом с ними. См. INTERVAL ниже для деталей.
INTERVAL=1h

# --- Плечо и маржа (применяются к каждому символу из SYMBOLS) ---
LEVERAGE=3
MARGIN_TYPE=ISOLATED

# --- Стратегия ---
# Значения ниже — победитель walk-forward подбора параметров (cmd/tune
# -interval 1h -folds 3) на 3 годах истории по 7 монетам выше, holdout —
# последние 6 месяцев в 3 отдельных периодах, честные комиссии +
# проскальзывание (25.08.2026). Это ЛУЧШИЙ из проверенных наборов, но даже
# он отрицательный на каждом из 3 периодов — см. предупреждение у SYMBOLS
# выше. Разбор по каждой монете и периоду — в выводе cmd/tune.
#
# Вход в лонг: пробой вверх окна LOOKBACK_BARS + цена выше тренда (EMA) +
# объём выше среднего + ADX выше порога (см. TREND_STRENGTH_MIN_ADX ниже).
# Вход в шорт — то же самое зеркально. Плюс два независимых входа —
# FUNDING_CARRY_MIN_RATE и (масштаб позиции) VOL_TARGET_PERIOD ниже.
# Одиночный пробой сам по себе сигналом не считается.
LOOKBACK_BARS=30
# Насколько закрытие должно превысить максимум окна, в процентах.
BREAKOUT_PCT=0.05
# Сколько свечей не входить после закрытия сделки.
COOLDOWN_BARS=3

# Период EMA для фильтра тренда: вход только когда close выше неё (для
# шорта — ниже). 100, не 20: после добавления funding carry и vol target
# перепроверка (25.08.2026) снова выбрала более медленную/сглаженную EMA.
TREND_EMA_PERIOD=100
# Период ATR (Average True Range) — от него считаются стоп/тейк и размер
# позиции, поэтому стоп автоматически шире на волатильных символах и уже
# на спокойных, а не одинаковый процент для всех.
ATR_PERIOD=14
# Период скользящей средней объёма для объёмного фильтра.
VOLUME_AVG_PERIOD=20
# Во сколько раз объём пробойной свечи должен превышать среднюю.
VOLUME_MULTIPLIER=2.0

# Расстояние до стопа = ATR * этот множитель.
ATR_STOP_MULTIPLIER=3.0
# Расстояние до тейка = расстояние до стопа * это отношение (risk:reward).
RISK_REWARD_RATIO=1.0

# Период ADX (сила тренда, Уайлдер). Не входить, если ADX ниже порога ниже
# — рынок в боковике, пробой скорее ложный. Добавлено 24.08.2026 по итогам
# walk-forward: заметно улучшило метрику относительно отсутствия фильтра
# (меньше сделок, но качественнее), хоть и не сделало стратегию прибыльной
# на последних 6 месяцах — см. предупреждение у SYMBOLS.
ADX_PERIOD=14
# 0 — фильтр выключен. 25 — порог из победившей комбинации.
TREND_STRENGTH_MIN_ADX=25

# После профита в этот множитель риска (R) стоп переносится в безубыток
# (один раз за сделку), тейк не трогается. 0 — выключено. При RR=1.0 (см.
# RISK_REWARD_RATIO выше) порог >= 1.0 почти бесполезен: тейк почти всегда
# успевает сработать раньше — так и вышло на подборе (1R/1.5R не дали
# заметной разницы) — оставлено выключенным, отдельный подбор порога
# МЕНЬШЕ RiskRewardRatio не делали.
BREAKEVEN_TRIGGER_R=0

# Доп. вход "на возврат к среднему" в боковике (ADX ниже порога выше).
# Перепроверялся вместе с carry/vol target (25.08.2026) — ни разу не
# улучшил walk-forward, топ-10 неизменно выбирали его выключенным.
# Оставлен выключенным намеренно, не забыт.
MEAN_REV_ATR_MULTIPLIER=0

# Доп. вход "на funding carry" — независимо от тренда/боковика: лонг, когда
# funding rate меньше -FUNDING_CARRY_MIN_RATE (шорты платят лонгам), шорт —
# когда больше +FUNDING_CARRY_MIN_RATE (лонги платят шортам). Единственная
# из проверенных 25.08.2026 добавок, которая реально и стабильно улучшила
# walk-forward — все топ-10 комбинаций выбрали её включённой, лучший
# результат поднялся с -5.86 до -5.11. 0 — выключено.
FUNDING_CARRY_MIN_RATE=0.001

# Таргетирование волатильности: если ATR в момент входа выше своего среднего
# за это число баров, риск на сделку пропорционально уменьшается (никогда не
# увеличивается). Вторая добавка, подтвердившая пользу на прогоне
# 25.08.2026 — подняла результат с -5.11 до -4.79 и заметно сузила просадки
# в бэктесте (были 4-8%+ за период, стали 1-6%). 0 — выключено.
VOL_TARGET_PERIOD=50

# Подтверждение пробоя дисбалансом потока ордеров: доля объёма пробойной
# свечи от агрессивных покупателей (TakerBuyVolume/Volume у Binance — нет
# доступа к самому стакану для бэктеста, это ближайший бесплатный и
# исторически доступный прокси) должна быть >= этого порога для лонга и
# <= 1-порог для шорта. Третья добавка, подтвердившая пользу отдельным
# прогоном (25.08.2026, cmd/tune -mode orderflow) — порог 0.55-0.7 дал
# идентичный набор сделок (граница резкая, не размытая), 0.6 взят серединой.
# Улучшил walk-forward score с -5.72 до -5.30 — как и ADX/VolTarget выше,
# не делает стратегию прибыльной сам по себе, но заметно и стабильно лучше
# без фильтра. 0 — выключено.
ORDER_FLOW_MIN_RATIO=0.6

# --- Риск-менеджмент ---
# Риск на одну сделку, % от эквити счёта. Размер позиции считается от этого
# и от расстояния до стопа — поэтому объём авто-подстраивается под баланс,
# QUANTITY больше не задаётся вручную.
RISK_PER_TRADE_PCT=1.0
# Максимум суммарного риска по ВСЕМ открытым позициям сразу (по всем
# символам), % от эквити. Не даёт открыть много сделок одновременно и
# случайно превысить приемлемый риск на портфель.
PORTFOLIO_RISK_CAP_PCT=4.5
# Дневной лимит убытка, % от эквити. При превышении новые сделки не
# открываются до начала следующих суток (UTC); уже открытые позиции
# продолжают управляться стопом/тейком как обычно.
DAILY_LOSS_LIMIT_PCT=3.0
# Максимальная просадка от исторического пика эквити, % — новые сделки не
# открываются, пока эквити не отыграет обратно выше порога (без ручного
# сброса, в отличие от дневного лимита выше он НЕ сбрасывается каждые сутки).
# Добавлено 24.08.2026: честный бэктест портфеля целиком на одном общем
# эквити (cmd/backtest -mode full) показал просадку 32% — заметно глубже,
# чем по каждому символу отдельно (10-18%), потому что все монеты
# коррелированы и могут проседать вместе. Портфельный риск-кап выше защищает
# от одновременно открытого риска, дневной лимит — от одних суток; растянутую
# во времени серию убыточных дней подряд не ловит ни один из них. 20% —
# заметно выше обычного шума отдельного символа, но заметно ниже найденных
# 32% — сработает раньше худшей точки. 0 — выключено.
MAX_DRAWDOWN_PCT=20

# --- Уведомления и статус (необязательно) ---
# Токен бота и chat_id для уведомлений о сделках/ошибках в Telegram, плюс
# команда /status (сводка по обоим ботам — направленному и ротации, если
# ROTATION_STATE_PATH ниже указан). Пусто — уведомления просто не отправляются,
# бот работает как обычно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Путь к файлу состояния cmd/rotationbot (см. internal/rotation), если он
# запущен на этой же машине — нужен только для того, чтобы /status показывал
# и его тоже. Пусто — раздел про ротацию в /status просто не появится.
ROTATION_STATE_PATH=
# То же самое для cmd/carrybot (виртуальный delta-neutral carry, см.
# internal/carry) — путь к его файлу состояния для /status. Пусто — раздел
# про carry в /status не появится.
CARRY_STATE_PATH=

# --- Наблюдаемость (необязательно) ---
# Адрес (например :9090), на котором отдавать /metrics в формате Prometheus.
# Пусто по умолчанию — порт не открывается, пока явно не попросили.
METRICS_ADDR=
# Уровень логирования: debug|info|warn|error. См. internal/logging —
# распознаёт только реальные проблемы (warn/error) через text-grep в
# journalctl, не полноценную приоритетную фильтрацию journald.
LOG_LEVEL=info
